class StudyAgent:
    def __init__(self):
        # Initialize state tracker
        self.state = {
            'topics_covered': [],
            'difficult_areas': [],
            'current_topic': None
        }

    def input_understanding(self, user_input):
        # Basic interpretation of user input
        if 'explain' in user_input.lower():
            intent = 'explanation'
        elif 'quiz' in user_input.lower():
            intent = 'quiz'
        elif 'help' in user_input.lower():
            intent = 'help'
        else:
            intent = 'general'

        # Extract topic (very simplified)
        topic = None
        if 'photosynthesis' in user_input.lower():
            topic = 'photosynthesis'
        elif 'cell' in user_input.lower():
            topic = 'cell biology'

        return {'intent': intent, 'topic': topic}

    def state_tracker(self, interpreted_input):
        # Update context based on interpreted input
        topic = interpreted_input.get('topic')
        if topic:
            self.state['topics_covered'].append(topic)
            self.state['current_topic'] = topic
        return self.state

    def task_planner(self, interpreted_input, state):
        # Decide what to do next
        intent = interpreted_input['intent']
        topic = interpreted_input.get('topic')

        if intent == 'explanation' and topic:
            return {'action': 'explain', 'topic': topic}
        elif intent == 'quiz' and topic:
            return {'action': 'quiz', 'topic': topic}
        elif intent == 'help':
            return {'action': 'provide_resources'}
        else:
            return {'action': 'ask_clarification'}

    def output_generator(self, plan, state):
        # Generate response based on plan
        action = plan['action']
        if action == 'explain':
            topic = plan['topic']
            return f"Here's a brief explanation of {topic}..."
        elif action == 'quiz':
            topic = plan['topic']
            return f"Here's a quiz question on {topic}: What is ...?"
        elif action == 'provide_resources':
            return "Here are some resources to help you study."
        else:
            return "Could you please clarify your request?"

# Example interaction
agent = StudyAgent()

# User input
user_input = "Can you explain photosynthesis?"

# Step 1: Input Understanding
interpreted = agent.input_understanding(user_input)

# Step 2: State Tracking
state = agent.state_tracker(interpreted)

# Step 3: Task Planning
plan = agent.task_planner(interpreted, state)

# Step 4: Output Generation
response = agent.output_generator(plan, state)

print(response)
